---
import AppLayout from "../layouts/AppLayout.astro"
---

<AppLayout>
  <main id="app-content" style="flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:3rem 2rem;">
    <div style="text-align:center;max-width:28rem;">
      <svg width="48" height="48" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" style="margin:0 auto 1.5rem;">
        <rect width="32" height="32" rx="8" fill="var(--accent)"/>
        <path d="M9 22V10l7 6-7 6z" fill="currentColor" opacity="0.6"/>
        <path d="M16 22V10l7 6-7 6z" fill="currentColor"/>
      </svg>
      <h1 style="font-size:var(--text-xl);font-weight:600;color:var(--text-primary);margin-bottom:0.5rem;">MiMoCode</h1>
      <p style="color:var(--text-dimmed);font-size:var(--text-sm);margin-bottom:2rem;">AI coding agent for the terminal</p>

      <div style="display:flex;flex-direction:column;gap:0.5rem;align-items:stretch;">
        <a href="/docs/s/" style="display:flex;align-items:center;gap:0.5rem;padding:0.625rem 1rem;background:var(--bg-surface);border:1px solid var(--border);border-radius:var(--radius-lg);color:var(--text-primary);font-size:var(--text-sm);font-weight:500;text-decoration:none;transition:all 0.15s;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
          <span style="flex:1;">View Share Page</span>
          <span style="color:var(--text-dimmed);font-size:var(--text-xs);">/s/:id</span>
        </a>

        <a href="https://opencode.ai/docs" target="_blank" rel="noopener noreferrer" style="display:flex;align-items:center;gap:0.5rem;padding:0.625rem 1rem;background:var(--bg-surface);border:1px solid var(--border);border-radius:var(--radius-lg);color:var(--text-primary);font-size:var(--text-sm);font-weight:500;text-decoration:none;transition:all 0.15s;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 014 4v14a3 3 0 00-3-3H2z"/><path d="M22 3h-6a4 4 0 00-4 4v14a3 3 0 013-3h7z"/></svg>
          <span style="flex:1;">Documentation</span>
        </a>

        <a href="https://github.com/anomalyco/opencode" target="_blank" rel="noopener noreferrer" style="display:flex;align-items:center;gap:0.5rem;padding:0.625rem 1rem;background:var(--bg-surface);border:1px solid var(--border);border-radius:var(--radius-lg);color:var(--text-primary);font-size:var(--text-sm);font-weight:500;text-decoration:none;transition:all 0.15s;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
          <span style="flex:1;">GitHub</span>
        </a>
      </div>
    </div>
  </main>
</AppLayout>
